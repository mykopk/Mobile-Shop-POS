{
  "name": "fig-pos-desktop",
  "version": "0.1.14",
  "private": true,
  "description": "Fig POS for Mobile Phones — the point of sale built for new and used phone shops",
  "author": "Fig POS",
  "main": "main.js",
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "pack:win": "electron-builder --win --dir --publish never",
    "dist:win": "electron-builder --win --publish never",
    "rebuild": "electron-rebuild -f --only better-sqlite3 --module-dir ../backend",
    "rebuild:dev": "npm --prefix ../backend rebuild better-sqlite3",
    "build:production": "npm --prefix ../backend run build:production && npm --prefix ../frontend run build:production"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-rebuild": "^3.2.9"
  }
}
