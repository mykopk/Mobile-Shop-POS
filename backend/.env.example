# Fig Mobile POS — backend environment variables.
# Copy to `.env` and fill in real values. Never commit `.env`.

# SQLite file (relative paths resolve from the process working directory).
# The production desktop app points this at its own data directory.
DATABASE_URL="file:./data/fig.db"

# Bind address. Use "localhost" so the frontend (localhost) and API share the
# same site — required for the SameSite=Lax session cookie to be sent on fetch.
# 127.0.0.1 and localhost are DIFFERENT sites for cookie purposes.
HOST=localhost

# API port (chosen to avoid clashing with other dev servers on 4000)
PORT=4100

# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-random-secret"

# JWT lifetime (ms | s | m | h | d)
JWT_EXPIRES_IN=7d

# bcrypt cost for PIN hashing
BCRYPT_ROUNDS=10

# Comma-separated list of allowed frontend origins (e.g. "http://localhost:3000").
# The frontend and API must share the same host (localhost) for cookie auth.
# Leave empty to allow all origins (dev only).
CORS_ORIGIN="http://localhost:3000"

# Login brute-force protection (per IP + username)
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5

# Automatic backups (saved to ./backups, see core/lib/backup.ts)
# Take a backup a few seconds after startup, then every BACKUP_INTERVAL_HOURS.
AUTO_BACKUP_ON_START=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14

# Seed-only: PINs for demo users (e.g. SEED_PIN_ARSLAN=483920).
# If unset, the seed generates a random PIN and prints it — nothing ships with 1111/2222/3333.
# SEED_PIN_ARSLAN=
# SEED_PIN_SAIMA=
# SEED_PIN_ALI=
